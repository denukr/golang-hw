{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Storage App",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/3-struct/main.go", // Путь к main внутри папки 3-struct
            "cwd": "${workspaceFolder}",            // Устанавливает рабочую директорию проекта
            "console": "integratedTerminal",
            "args": [
                "--file", "${workspaceFolder}/3-struct/file.json",
                "--name", "MyCloudBin",
                "--create"
            ]
        }
    ]
}
